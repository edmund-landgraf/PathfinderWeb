PORT=3333

# Trusted connection / Windows auth style. Works when msnodesqlv8 driver is available.
# If that is awkward, set SQL_USER and SQL_PASSWORD instead.
SQL_SERVER=localhost
SQL_DATABASE=PathfinderUtil
SQL_PORT=1433
SQL_TRUSTED_CONNECTION=true
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# If true, creature art is always shown and the Settings unlock item is hidden.
# Localhost: ENABLE_ART=true. Production: ENABLE_ART=false, then set ENABLE_ART_PWD.
# ENABLE_ART_PWD is a shared easy password. It only reveals art. It does not
# grant admin, and it is not required to be a strong secret.
ENABLE_ART=true
ENABLE_ART_PWD=

# Optional HMAC key for the art cookie. When unset, the server derives a key
# from ENABLE_ART_PWD that is separate from the admin cookie key.
# ART_COOKIE_SECRET=

# Admin unlock. Required to create, edit, rename, delete, or upload custom
# creatures, and to upload canon creature art. Both values are required, must
# be at least 16 characters, and must be different secrets. There is no default;
# if either is missing or too short, /api/admin/unlock fails closed (HTTP 503).
# Generate each with: openssl rand -base64 32
ADMIN_UNLOCK_SECRET=
ADMIN_COOKIE_SECRET=

# Number of reverse proxies to trust when reading the client IP (nginx is 1).
# Used for unlock rate limits. 0 ignores X-Forwarded-For. Do not trust extra
# hops; clients can prepend fake addresses.
TRUST_PROXY_HOPS=1

# Include SQL WHERE/params in API JSON and verbose SQL logs. Off unless exactly true.
# DEBUG_SQL=true

# In-memory LRU cache for row-level monster image thumbnails (default: 1000 entries / 128 MB).
MONSTER_IMAGE_CACHE_MAX=1000
MONSTER_IMAGE_CACHE_MAX_BYTES=134217728

# SQL timeouts in milliseconds.
SQL_REQUEST_TIMEOUT_MS=120000
SQL_CONNECTION_TIMEOUT_MS=15000
